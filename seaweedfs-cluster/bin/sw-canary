#!/usr/bin/env python3
"""
sw-canary - end-to-end replication canary for a Primary -> DR SeaweedFS pair.

Writes a small object through the Primary S3 endpoint and measures how long it takes to become
readable through the DR S3 endpoint. This is the only reliable DR health signal: in the lab the
Data Movement policy status kept reporting 'caught_up' while replication had stopped (E-08/E-10).

  one-shot (exit 0 = replicated within --timeout):
      sw-canary --src https://s3-primary:443 --dst https://s3-dr:443 --bucket archive
  daemon with Prometheus metrics on :9340 (seaweedfs_dr_canary_*):
      sw-canary ... --interval 60 --listen 0.0.0.0:9340

Credentials: SRC_/DST_AWS_ACCESS_KEY_ID / _SECRET_ACCESS_KEY (fallback AWS_*). Use an identity
scoped to Write on <bucket>/<prefix> only. Canary objects older than --keep are deleted.
"""
import argparse
import http.server
import json
import os
import sys
import threading
import time

import boto3
from botocore.config import Config

STATE = {"last_lag": -1.0, "last_ok_ts": 0.0, "last_run_ts": 0.0, "consecutive_fail": 0, "runs": 0, "fails": 0}


def client(ep, side, timeout):
    ak = os.environ.get(f"{side}_AWS_ACCESS_KEY_ID") or os.environ.get("AWS_ACCESS_KEY_ID")
    sk = os.environ.get(f"{side}_AWS_SECRET_ACCESS_KEY") or os.environ.get("AWS_SECRET_ACCESS_KEY")
    return boto3.client("s3", endpoint_url=ep, aws_access_key_id=ak, aws_secret_access_key=sk,
                        region_name=os.environ.get("AWS_REGION", "us-east-1"),
                        config=Config(s3={"addressing_style": "path"}, connect_timeout=5, read_timeout=timeout,
                                      retries={"max_attempts": 2, "mode": "standard"}))


def probe(src, dst, bucket, prefix, timeout):
    key = f"{prefix}/{time.strftime('%Y/%m/%d')}/{int(time.time() * 1000)}"
    body = f"canary {time.time()}".encode()
    src.put_object(Bucket=bucket, Key=key, Body=body)
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            if dst.get_object(Bucket=bucket, Key=key)["Body"].read() == body:
                return round(time.time() - t0, 2), key
        except Exception:  # noqa: BLE001
            pass
        time.sleep(0.5)
    return None, key


def cleanup(src, bucket, prefix, keep_s):
    cutoff = (time.time() - keep_s) * 1000
    token = None
    while True:
        kw = dict(Bucket=bucket, Prefix=prefix + "/", MaxKeys=1000)
        if token:
            kw["ContinuationToken"] = token
        r = src.list_objects_v2(**kw)
        old = [o["Key"] for o in r.get("Contents", []) if o["Key"].rsplit("/", 1)[-1].isdigit()
               and int(o["Key"].rsplit("/", 1)[-1]) < cutoff]
        for k in old:
            src.delete_object(Bucket=bucket, Key=k)
        token = r.get("NextContinuationToken")
        if not token:
            return


class Metrics(http.server.BaseHTTPRequestHandler):
    def do_GET(self):  # noqa: N802
        s = STATE
        age = time.time() - s["last_ok_ts"] if s["last_ok_ts"] else -1
        body = (
            "# HELP seaweedfs_dr_canary_lag_seconds Seconds for the last canary to become readable on DR (-1 = not replicated)\n"
            "# TYPE seaweedfs_dr_canary_lag_seconds gauge\n"
            f"seaweedfs_dr_canary_lag_seconds {s['last_lag']}\n"
            "# HELP seaweedfs_dr_canary_last_success_age_seconds Seconds since a canary last replicated\n"
            "# TYPE seaweedfs_dr_canary_last_success_age_seconds gauge\n"
            f"seaweedfs_dr_canary_last_success_age_seconds {age:.0f}\n"
            "# TYPE seaweedfs_dr_canary_consecutive_failures gauge\n"
            f"seaweedfs_dr_canary_consecutive_failures {s['consecutive_fail']}\n"
            "# TYPE seaweedfs_dr_canary_runs_total counter\n"
            f"seaweedfs_dr_canary_runs_total {s['runs']}\n"
            "# TYPE seaweedfs_dr_canary_failures_total counter\n"
            f"seaweedfs_dr_canary_failures_total {s['fails']}\n").encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; version=0.0.4")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--src", required=True)
    ap.add_argument("--dst", required=True)
    ap.add_argument("--bucket", required=True)
    ap.add_argument("--prefix", default="_canary")
    ap.add_argument("--timeout", type=float, default=60, help="seconds to wait for the object on DR (set to RPO)")
    ap.add_argument("--interval", type=float, default=0, help="daemon mode: seconds between probes")
    ap.add_argument("--listen", default="", help="daemon mode: host:port for /metrics")
    ap.add_argument("--keep", type=float, default=86400, help="delete canary objects older than this")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    src, dst = client(a.src, "SRC", a.timeout), client(a.dst, "DST", a.timeout)
    if a.listen:
        h, p = a.listen.rsplit(":", 1)
        threading.Thread(target=http.server.ThreadingHTTPServer((h, int(p)), Metrics).serve_forever,
                         daemon=True).start()
    n = 0
    while True:
        STATE["runs"] += 1
        STATE["last_run_ts"] = time.time()
        try:
            lag, key = probe(src, dst, a.bucket, a.prefix, a.timeout)
        except Exception as e:  # noqa: BLE001
            lag, key = None, f"error: {e}"
        if lag is None:
            STATE.update(last_lag=-1, consecutive_fail=STATE["consecutive_fail"] + 1, fails=STATE["fails"] + 1)
        else:
            STATE.update(last_lag=lag, last_ok_ts=time.time(), consecutive_fail=0)
        res = {"key": key, "replicated": lag is not None, "lag_s": lag, **STATE}
        print(json.dumps(res) if a.json else
              (f"canary {key}: replicated in {lag}s" if lag is not None else f"canary {key}: NOT replicated within {a.timeout}s"),
              flush=True)
        if not a.interval:
            return 0 if lag is not None else 2
        n += 1
        if n % 60 == 0:
            try:
                cleanup(src, a.bucket, a.prefix, a.keep)
            except Exception:  # noqa: BLE001
                pass
        time.sleep(a.interval)


if __name__ == "__main__":
    sys.exit(main())
