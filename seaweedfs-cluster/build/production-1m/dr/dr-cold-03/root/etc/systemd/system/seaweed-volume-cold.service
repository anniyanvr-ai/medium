# Generated by swctl from production-1m.yaml - do not edit by hand
[Unit]
Description=SeaweedFS volume_cold (dr/dr-cold-03)
After=network-online.target 
Wants=network-online.target

[Service]
Type=simple
User=seaweedfs
Group=seaweedfs
WorkingDirectory=/etc/seaweedfs
EnvironmentFile=/etc/seaweedfs/seaweed.env
EnvironmentFile=/etc/seaweedfs/seaweed-volume-cold.env
ExecStart=/opt/seaweedfs/weed $WEED_ARGS
Restart=always
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=1048576
LimitNPROC=65536
# hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/data/hdd1 /data/hdd2 /data/hdd3 /data/seaweed

[Install]
WantedBy=multi-user.target
