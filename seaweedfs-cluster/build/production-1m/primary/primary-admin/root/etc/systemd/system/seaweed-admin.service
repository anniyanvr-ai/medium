# Generated by swctl from production-1m.yaml - do not edit by hand
[Unit]
Description=SeaweedFS admin (primary/primary-admin)
After=network-online.target 
Wants=network-online.target

[Service]
Type=simple
User=seaweedfs
Group=seaweedfs
WorkingDirectory=/etc/seaweedfs
EnvironmentFile=/etc/seaweedfs/seaweed.env
EnvironmentFile=/etc/seaweedfs/seaweed-admin.env
ExecStart=/opt/seaweedfs/weed $WEED_ARGS
Restart=always
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=1048576
LimitNPROC=65536
# hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/data/seaweed

[Install]
WantedBy=multi-user.target
