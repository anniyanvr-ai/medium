# Generated by swctl - end-to-end DR canary (primary -> dr)
[Unit]
Description=SeaweedFS DR canary primary->dr
After=network-online.target
[Service]
User=seaweedfs
EnvironmentFile=/etc/seaweedfs/ops.env
ExecStart=/opt/seaweedfs-deploy/bin/sw-canary --src http://s3-primary.company.com --dst http://s3-dr.company.com --bucket archive \
    --timeout 60 --interval 60 --listen 0.0.0.0:9340
Restart=always
RestartSec=10
[Install]
WantedBy=multi-user.target
