{
  "selectors": [
    {
      "match": [
        "**"
      ],
      "volumeClass": "archive-data"
    }
  ],
  "profiles": [
    {
      "name": "archive-hot-cold-test",
      "landing": {
        "diskType": "ssd",
        "replication": "010"
      },
      "tiers": [
        {
          "name": "cold-ec",
          "when": {
            "quietForSeconds": 300
          },
          "ec": {
            "diskType": "hdd",
            "dataShards": 6,
            "parityShards": 3
          }
        }
      ]
    }
  ],
  "bindings": [
    {
      "collectionPattern": "archive",
      "volumeClass": "archive-data",
      "profileName": "archive-hot-cold-test"
    }
  ]
}